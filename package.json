{
   "name": "stack-lang",
   "displayName": "Stack lang",
   "description": "language server for STACK software package",
   "version": "0.7.1",
   "stack": {
      "serverVersion": "0.7.1"
   },
   "repository": "https://github.com/stonum/vscode-stack-lang",
   "publisher": "stonum",
   "categories": [
      "Programming Languages",
      "Formatters",
      "Linters"
   ],
   "icon": "images/mark-logo-stack.png",
   "license": "MIT",
   "keywords": [
      "language-server",
      "stack"
   ],
   "engines": {
      "vscode": "^1.69.0"
   },
   "activationEvents": [
      "onLanguage:stack",
      "onLanguage:sql",
      "onLanguage:stack-resource",
      "onLanguage:stack-dictionary"
   ],
   "main": "./dist/extension.js",
   "contributes": {
      "languages": [
         {
            "id": "stack",
            "aliases": [
               "stack"
            ],
            "extensions": [
               ".prg",
               ".hdl",
               ".rpt"
            ],
            "firstLine": "^#![Ss][Tt][Aa][Cc][Kk]\\b",
            "configuration": "./syntaxes/configuration.json"
         },
         {
            "id": "stack-resource",
            "aliases": [
               "resource"
            ],
            "filenamePatterns": [
               "*.rx*",
               "*.RX*"
            ],
            "configuration": "./syntaxes/xml-configuration.json"
         },
         {
            "id": "stack-dictionary",
            "aliases": [
               "dictionary"
            ],
            "extensions": [
               ".xdic"
            ],
            "configuration": "./syntaxes/xml-configuration.json"
         }
      ],
      "grammars": [
         {
            "language": "stack",
            "scopeName": "source.stack",
            "path": "./syntaxes/stack.json"
         },
         {
            "language": "stack-resource",
            "scopeName": "source.stack-xml",
            "path": "./syntaxes/xml-base.tmLanguage.json"
         },
         {
            "language": "stack-dictionary",
            "scopeName": "source.stack-xml",
            "path": "./syntaxes/xml-base.tmLanguage.json"
         }
      ],
      "commands": [
         {
            "command": "stack.togglePostgreSQL",
            "title": "Replaces tildas in the psql query to schema and backward",
            "category": "stack"
         },
         {
            "command": "stack.fieldsToPostgreSQL",
            "title": "Replaces [] на \"",
            "category": "stack"
         },
         {
            "command": "stack.toggleMsSQL",
            "title": "Replaces tildas in the mssql query to schema and backward",
            "category": "stack"
         }
      ],
      "keybindings": [
         {
            "command": "stack.togglePostgreSQL",
            "key": "ctrl+shift+r",
            "mac": "cmd+shift+r",
            "when": "editorTextFocus"
         }
      ],
      "configuration": {
         "type": "object",
         "title": "Stack lang",
         "properties": {
            "stack.iniPath": {
               "title": "Path to INI file",
               "markdownDescription": "Path to stack.ini file. It used for filter loaded folders.",
               "default": "",
               "type": "string"
            },
            "stack.lens.enabled": {
               "title": "lens",
               "markdownDescription": "Whether to show CodeLens in Stack files.",
               "default": true,
               "type": "boolean"
            }
         }
      },
      "snippets": [
         {
            "language": "stack",
            "path": "./snippets/snippets.json"
         }
      ],
      "configurationDefaults": {
         "[stack-resource]": {
            "editor.tabSize": 3
         },
         "[stack-dictionary]": {
            "editor.tabSize": 4
         }
      }
   },
   "scripts": {
      "download-server": "node scripts/download-server.js",
      "check-types": "tsc --noEmit",
      "compile": "rm -rf dist && npm run check-types && node esbuild.js",
      "watch": "rm -rf dist && node esbuild.js --watch",
      "watch:types": "tsc --noEmit --watch",
      "vscode:prepublish": "rm -rf dist && npm run check-types && node esbuild.js --production",
      "package": "vsce package",
      "publish": "vsce publish"
   },
   "dependencies": {
      "vscode-languageclient": "^9.0.1"
   },
   "devDependencies": {
      "@vscode/vsce": "^3.9.0",
      "@types/node": "^26.1.2",
      "@types/vscode": "1.69.0",
      "@typescript-eslint/eslint-plugin": "^8.59.1",
      "@typescript-eslint/parser": "^8.46.0",
      "@electron/rebuild": "4.0.4",
      "esbuild": "^0.28.1",
      "eslint": "^10.3.0",
      "glob": "^13.0.6",
      "typescript": "^5.9.3",
      "vscode-uri": "^3.0.2"
   }
}
