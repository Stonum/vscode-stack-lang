// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
   "version": "2.0.0",
   "tasks": [
      {
         "label": "Client watch",
         "dependsOn": ["watch:esbuild", "watch:types"],
         "presentation": {
            "reveal": "never",
         },
         "group": {
            "kind": "build",
            "isDefault": true,
         },
      },
      {
         "label": "watch:esbuild",
         "type": "npm",
         "script": "watch",
         "isBackground": true,
         "problemMatcher": {
            "owner": "esbuild",
            "source": "esbuild",
            "fileLocation": "relative",
            "pattern": {
               "regexp": "^\\s*✘ \\[ERROR\\] (.*)$",
               "message": 1,
            },
            "background": {
               "activeOnStart": true,
               "beginsPattern": "^\\[build\\] started$",
               "endsPattern": "^\\[build\\] finished$",
            },
         },
         "presentation": {
            "group": "watch",
            "reveal": "never",
         },
      },
      {
         "label": "watch:types",
         "type": "npm",
         "script": "watch:types",
         "isBackground": true,
         "problemMatcher": "$tsc-watch",
         "presentation": {
            "group": "watch",
            "reveal": "never",
         },
      },
   ],
}
